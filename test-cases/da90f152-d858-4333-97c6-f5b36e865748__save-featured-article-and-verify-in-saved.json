{
  "id": "save-featured-article-and-verify-in-saved",
  "testPlanId": "da90f152-d858-4333-97c6-f5b36e865748",
  "requirementId": "72e65a65-bcce-4f10-ba6b-fedeebd56b66",
  "suiteName": "Save News Article Card — Functional Happy Paths",
  "case": {
    "id": "save-featured-article-and-verify-in-saved",
    "title": "Save a Featured article and verify Saved indicator and presence in My saved news",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Commons QA homepage",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s2",
        "action": "waitForVisible",
        "targetDescription": "Featured section",
        "locatorHint": "[data-testid='featured-news-section']",
        "screenName": "UKGCommons"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "save news",
        "locatorHint": "[data-testid='featured-news-section'] [data-testid='featured-card']:has-text('QA Fixture: Save Me') [data-testid='bookmark-toggle']",
        "screenName": "UKGCommons"
      },
      {
        "id": "s5",
        "action": "assertVisible",
        "targetDescription": "unsave news",
        "locatorHint": "[data-testid='featured-news-section'] [data-testid='featured-card']:has-text('QA Fixture: Save Me') [data-testid='saved-indicator']",
        "screenName": "UKGCommons"
      },
      {
        "id": "s6",
        "action": "tap",
        "targetDescription": "profile",
        "locatorHint": "[data-testid='profile-menu-button']",
        "screenName": "UKGCommons",
        "value": "[data-tour=\"user-profile\"]"
      },
      {
        "id": "s7",
        "action": "tap",
        "targetDescription": "My saved news",
        "locatorHint": "[data-testid='menu-saved-news']",
        "screenName": "UKGCommons"
      },
      {
        "id": "s8",
        "action": "waitForVisible",
        "targetDescription": "my Saved News",
        "locatorHint": "[data-testid='saved-news-page']",
        "screenName": "SavedNews"
      },
      {
        "id": "s9",
        "action": "assertVisible",
        "targetDescription": "unsave news",
        "locatorHint": "[data-testid='saved-news-page']",
        "screenName": "SavedNews"
      }
    ],
    "tags": [
      "@functional",
      "@regression"
    ]
  }
}
