{
  "id": "save-latest-article-and-verify-in-saved",
  "testPlanId": "da90f152-d858-4333-97c6-f5b36e865748",
  "requirementId": "72e65a65-bcce-4f10-ba6b-fedeebd56b66",
  "suiteName": "Save News Article Card — Functional Happy Paths",
  "case": {
    "id": "save-latest-article-and-verify-in-saved",
    "title": "Save a Latest article and verify Saved indicator and presence in My saved news",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Commons QA homepage",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s2",
        "action": "waitForVisible",
        "targetDescription": "Latest section",
        "locatorHint": "[data-testid='latest-news-section']"
      },
      {
        "id": "s3",
        "action": "scrollIntoView",
        "targetDescription": "Scroll to Latest section",
        "locatorHint": "[data-testid='latest-news-section']"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Tap bookmark on 'QA Fixture: Latest Fixture' Latest card",
        "locatorHint": "[data-testid='latest-news-section'] [data-testid='latest-card']:has-text('QA Fixture: Latest Fixture') [data-testid='bookmark-toggle']"
      },
      {
        "id": "s5",
        "action": "assertVisible",
        "targetDescription": "Saved indicator appears on the Latest card",
        "locatorHint": "[data-testid='latest-news-section'] [data-testid='latest-card']:has-text('QA Fixture: Latest Fixture') [data-testid='saved-indicator']"
      },
      {
        "id": "s6",
        "action": "tap",
        "targetDescription": "Open profile menu",
        "locatorHint": "[data-testid='profile-menu-button']"
      },
      {
        "id": "s7",
        "action": "tap",
        "targetDescription": "Navigate to My saved news",
        "locatorHint": "[data-testid='menu-saved-news']"
      },
      {
        "id": "s8",
        "action": "waitForVisible",
        "targetDescription": "Saved News page loaded",
        "locatorHint": "[data-testid='saved-news-page']"
      },
      {
        "id": "s9",
        "action": "assertContainsText",
        "targetDescription": "Saved list contains the saved Latest article",
        "locatorHint": "[data-testid='saved-news-page']",
        "assertion": "QA Fixture: Latest Fixture"
      }
    ],
    "tags": [
      "@functional",
      "@regression"
    ]
  }
}
