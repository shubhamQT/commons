{
  "id": "icons-visible-on-featured-and-latest",
  "testPlanId": "183609fa-f97a-4aee-bfe4-79219c2de17e",
  "requirementId": "72e65a65-bcce-4f10-ba6b-fedeebd56b66",
  "suiteName": "Save News Article Card - E2E",
  "case": {
    "id": "icons-visible-on-featured-and-latest",
    "title": "Bookmark icons are visible on all article cards in Featured and Latest sections",
    "priority": "P2",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Commons QA homepage",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s2",
        "action": "waitForVisible",
        "targetDescription": "Featured News section is visible",
        "locatorHint": "section[aria-label='Featured News']"
      },
      {
        "id": "s3",
        "action": "assertCountGreaterThan",
        "targetDescription": "Featured News: bookmark icons present",
        "locatorHint": "section[aria-label='Featured News'] [data-testid='bookmark-toggle']"
      },
      {
        "id": "s4",
        "action": "waitForVisible",
        "targetDescription": "Latest News section is visible",
        "locatorHint": "section[aria-label='Latest News']"
      },
      {
        "id": "s5",
        "action": "assertCountGreaterThan",
        "targetDescription": "Latest News: bookmark icons present",
        "locatorHint": "section[aria-label='Latest News'] [data-testid='bookmark-toggle']"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
