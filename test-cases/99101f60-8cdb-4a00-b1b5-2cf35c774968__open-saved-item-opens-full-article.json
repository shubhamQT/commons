{
  "id": "open-saved-item-opens-full-article",
  "testPlanId": "99101f60-8cdb-4a00-b1b5-2cf35c774968",
  "requirementId": "8186accb-be80-4df7-a765-9df9c34b80a9",
  "suiteName": "UKG Commons Demo — Save News Articles (Functional)",
  "case": {
    "id": "open-saved-item-opens-full-article",
    "title": "Opening an item from Saved News navigates to the full article view",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "open-home",
        "action": "openUrl",
        "targetDescription": "Open Commons QA homepage",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "wait-feed",
        "action": "waitForVisible",
        "targetDescription": "Wait for news feed",
        "locatorHint": "[data-testid='news-feed']"
      },
      {
        "id": "scroll-target-card",
        "action": "scrollIntoView",
        "targetDescription": "Scroll to the target article card",
        "locatorHint": "[data-testid='news-card']:has-text('Take the next step in your development at UKG')"
      },
      {
        "id": "save-article",
        "action": "tap",
        "targetDescription": "Save the article",
        "locatorHint": "[data-testid='news-card']:has-text('Take the next step in your development at UKG') [data-testid='bookmark']"
      },
      {
        "id": "assert-saved-icon",
        "action": "assertVisible",
        "targetDescription": "Verify saved (filled) icon on the card",
        "locatorHint": "[data-testid='news-card']:has-text('Take the next step in your development at UKG') [data-testid='bookmark--filled']"
      },
      {
        "id": "open-profile-menu",
        "action": "tap",
        "targetDescription": "Open profile menu",
        "locatorHint": "[data-testid='profile-menu-button']"
      },
      {
        "id": "go-to-saved",
        "action": "tap",
        "targetDescription": "Select 'My saved news'",
        "locatorHint": "[data-testid='menu-saved-news']"
      },
      {
        "id": "wait-saved-list",
        "action": "waitForVisible",
        "targetDescription": "Wait for Saved News list",
        "locatorHint": "[data-testid='saved-news-list']"
      },
      {
        "id": "open-saved-item",
        "action": "tap",
        "targetDescription": "Open the saved article from the list",
        "locatorHint": "[data-testid='saved-news-item']:has-text('Take the next step in your development at UKG')"
      },
      {
        "id": "wait-article-view",
        "action": "waitForVisible",
        "targetDescription": "Wait for full article view to load",
        "locatorHint": "[data-testid='article-view']"
      },
      {
        "id": "assert-article-title",
        "action": "assertContainsText",
        "targetDescription": "Verify full article title is shown",
        "locatorHint": "[data-testid='article-title']",
        "assertion": "Take the next step in your development at UKG"
      },
      {
        "id": "cleanup-unsave-on-article",
        "action": "tap",
        "targetDescription": "Cleanup: Unsave from article detail view",
        "locatorHint": "[data-testid='article-view'] [data-testid='bookmark--filled']"
      },
      {
        "id": "assert-outline-on-article",
        "action": "assertVisible",
        "targetDescription": "Verify unsaved (outline) icon on article view",
        "locatorHint": "[data-testid='article-view'] [data-testid='bookmark']"
      }
    ],
    "tags": [
      "@functional",
      "@regression"
    ]
  }
}
