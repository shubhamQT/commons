{
  "id": "bookmark-icon-visible-on-featured-and-latest",
  "testPlanId": "e5ee00ac-1b1c-4208-ad2e-ba8ee40fea0a",
  "requirementId": "72e65a65-bcce-4f10-ba6b-fedeebd56b66",
  "suiteName": "Save News Article Card — E2E",
  "case": {
    "id": "bookmark-icon-visible-on-featured-and-latest",
    "title": "Bookmark icon visible on Featured and Latest news cards",
    "priority": "P1",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Commons QA Home",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s2",
        "action": "waitForVisible",
        "targetDescription": "Main content visible",
        "locatorHint": "main"
      },
      {
        "id": "s3",
        "action": "assertVisible",
        "targetDescription": "Featured section heading is visible",
        "locatorHint": "section[aria-label='Featured'] h2"
      },
      {
        "id": "s4",
        "action": "assertVisible",
        "targetDescription": "Bookmark icon on first Featured card is visible",
        "locatorHint": "section[aria-label='Featured'] [data-testid='news-card']:nth-of-type(1) [data-testid='bookmark-icon']"
      },
      {
        "id": "s5",
        "action": "assertVisible",
        "targetDescription": "Latest News section heading is visible",
        "locatorHint": "section[aria-label='Latest News'] h2"
      },
      {
        "id": "s6",
        "action": "assertVisible",
        "targetDescription": "Bookmark icon on first Latest News card is visible",
        "locatorHint": "section[aria-label='Latest News'] [data-testid='news-card']:nth-of-type(1) [data-testid='bookmark-icon']"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
