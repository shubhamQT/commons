{
  "id": "saved-persists-after-refresh",
  "testPlanId": "da90f152-d858-4333-97c6-f5b36e865748",
  "requirementId": "72e65a65-bcce-4f10-ba6b-fedeebd56b66",
  "suiteName": "Save News Article Card — Functional Happy Paths",
  "case": {
    "id": "saved-persists-after-refresh",
    "title": "Saved state persists after page refresh and appears in My saved news",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Commons QA homepage",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s2",
        "action": "waitForVisible",
        "targetDescription": "Featured section loaded",
        "locatorHint": "[data-testid='featured-news-section']"
      },
      {
        "id": "s3",
        "action": "tap",
        "targetDescription": "Save 'QA Fixture: Persist Me' on its card",
        "locatorHint": "[data-testid='featured-card']:has-text('QA Fixture: Persist Me') [data-testid='bookmark-toggle']"
      },
      {
        "id": "s4",
        "action": "openUrl",
        "targetDescription": "Refresh by reopening homepage",
        "value": "https://commons-qa.util.ukg.com/"
      },
      {
        "id": "s5",
        "action": "waitForVisible",
        "targetDescription": "Home feed container",
        "locatorHint": "[data-testid='news-home']"
      },
      {
        "id": "s6",
        "action": "assertVisible",
        "targetDescription": "Saved indicator persists on 'QA Fixture: Persist Me' card",
        "locatorHint": "[data-testid='news-home'] [data-testid='news-card']:has-text('QA Fixture: Persist Me') [data-testid='saved-indicator']"
      },
      {
        "id": "s7",
        "action": "tap",
        "targetDescription": "Open profile menu",
        "locatorHint": "[data-testid='profile-menu-button']"
      },
      {
        "id": "s8",
        "action": "tap",
        "targetDescription": "Go to My saved news",
        "locatorHint": "[data-testid='menu-saved-news']"
      },
      {
        "id": "s9",
        "action": "waitForVisible",
        "targetDescription": "Saved News page",
        "locatorHint": "[data-testid='saved-news-page']"
      },
      {
        "id": "s10",
        "action": "assertContainsText",
        "targetDescription": "'QA Fixture: Persist Me' appears in Saved list",
        "locatorHint": "[data-testid='saved-news-page']",
        "assertion": "QA Fixture: Persist Me"
      }
    ],
    "tags": [
      "@functional",
      "@regression"
    ]
  }
}
